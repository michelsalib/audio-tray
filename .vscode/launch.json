{
  // Requires the "C/C++" extension (ms-vscode.cpptools). cppvsdbg reads MSVC PDB debug
  // info natively — the right debugger for the x86_64-pc-windows-msvc toolchain.
  //
  // These build only `audio-tray`, not the TAP. Explorer pins the DLL while it is
  // loaded, so building it would fail exactly when the strip is up — and debugging
  // the app should not depend on that. Run the "cargo build TAP (debug)" task when
  // you have changed the TAP; it writes `target/debug/audio_tray_tap.dll`, which is
  // where `taskbar::enable()` looks.
  //
  // If that DLL has never been built, startup logs the strip as unavailable and the
  // app runs with the plain tray icon.
  //
  // Note the TAP runs inside `explorer.exe`, not here: this debugger will not stop
  // in it. Its log is `%TEMP%\xaml-tap.log`, and `--debug` in the init data turns on
  // the verbose tree dumps.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug tray (default)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/audio-tray.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "cargo build (debug)"
    },
    {
      "name": "Debug --list",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/audio-tray.exe",
      "args": ["--list"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "cargo build (debug)"
    }
  ]
}
