{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build (debug)",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "options": {
        "env": {
          // Ensure cargo is found even if this VS Code window started before rustup
          // added ~/.cargo/bin to PATH.
          "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:PATH}"
        }
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "reveal": "silent"
      }
    },
    {
      // The TAP is its own workspace (spikes/xaml-tap has an empty [workspace]),
      // so a plain `cargo build` at the root never touches it.
      "label": "cargo build TAP (debug)",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/spikes/xaml-tap",
        "env": {
          "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:PATH}"
        }
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      // `taskbar::enable()` loads `audio_tray_tap.dll` from beside the exe, while
      // cargo names the spike's output `xaml_tap.dll` — so it has to be copied
      // under the name the app looks for.
      //
      // The copy fails while a previous TAP is loaded, because Explorer pins it.
      // That is reported and then ignored on purpose: the stale DLL on disk is
      // still injectable, and failing the build would block launching entirely.
      // Restart Explorer to pick up a rebuilt TAP.
      "label": "stage TAP dll",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/stage-tap.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["cargo build TAP (debug)"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      // What the launch configs use: app + TAP, with the DLL staged where
      // `taskbar::enable()` will look for it.
      "label": "build all (debug)",
      "dependsOrder": "sequence",
      "dependsOn": ["cargo build (debug)", "stage TAP dll"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
