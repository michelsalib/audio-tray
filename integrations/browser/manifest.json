{
  "manifest_version": 3,
  "name": "Audio Tray",
  "version": "0.21.0",
  "description": "Shows every tab playing video or audio (Twitch, YouTube...) on Audio Tray's edge pill, with play/pause.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "alarms", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
